{
  "name": "@0dotxyz/p0-ts-sdk",
  "version": "3.0.0-next.1",
  "packageManager": "pnpm@10.32.1",
  "description": "TypeScript SDK for P0 Protocol - A Solana DeFi lending protocol",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vendor": {
      "import": {
        "types": "./dist/vendor.d.ts",
        "default": "./dist/vendor.js"
      },
      "require": {
        "types": "./dist/vendor.d.cts",
        "default": "./dist/vendor.cjs"
      }
    },
    "./jupiter": {
      "import": {
        "types": "./dist/jupiter.d.ts",
        "default": "./dist/jupiter.js"
      },
      "require": {
        "types": "./dist/jupiter.d.cts",
        "default": "./dist/jupiter.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rimraf dist",
    "lint": "eslint src tests --ext .ts,.tsx",
    "lint:fix": "eslint src tests --ext .ts,.tsx --fix",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "example:swap-engine": "tsx examples/swap-engine.ts",
    "example:mint-holders": "tsx examples/18-mint-holders.ts",
    "docs": "typedoc",
    "changeset": "changeset",
    "prepublishOnly": "pnpm build",
    "prepack": "pnpm build",
    "knip": "knip",
    "generate": "for config in codama/*.mjs; do codama run js -c $config || exit 1; done"
  },
  "keywords": [
    "solana",
    "defi",
    "lending",
    "typescript",
    "sdk",
    "p0",
    "blockchain",
    "web3"
  ],
  "author": "P0 Protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0dotxyz/p0-ts-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/0dotxyz/p0-ts-sdk/issues"
  },
  "homepage": "https://github.com/0dotxyz/p0-ts-sdk#readme",
  "engines": {
    "node": ">=20.18.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@solana-program/compute-budget": "^0.19.0",
    "@solana-program/stake": "^0.10.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.16.1",
    "@types/ws": "^8.18.1",
    "bignumber.js": "^9.1.2",
    "buffer": "^6.0.3",
    "decimal.js": "^10.5.0",
    "superstruct": "^1.0.4",
    "ws": "^8.20.0"
  },
  "peerDependencies": {
    "@solana/kit": "^8.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@codama/nodes": "^1.11.0",
    "@codama/nodes-from-anchor": "^1.5.6",
    "@codama/renderers-js": "^2.5.0",
    "@codama/visitors": "^1.11.0",
    "@solana-program/address-lookup-table": "^0.15.0",
    "@solana/kit": "^8.3.0",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.1",
    "codama": "^1.11.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "knip": "^6.34.0",
    "prettier": "^3.2.4",
    "rimraf": "^5.0.5",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typedoc": "^0.26.2",
    "typescript": "^5.5.2",
    "vitest": "^4.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
