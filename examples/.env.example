# Project 0 SDK Examples Configuration
# Copy this file to .env and fill in your values

# RPC Connection
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed

# Marginfi Configuration
MARGINFI_ENVIRONMENT=production
MARGINFI_GROUP_ADDRESS=4qp6Fx6tnZkY5Wropq9wUYgtFxXKwE6viZxFHg3rdAG8
MARGINFI_PROGRAM_ID=MFv2hWf31Z9kbCa1snEPYctwafyhdvnV7FZnsebVacA

# Your Account and Wallet (for simulation - no private key needed!)
MARGINFI_ACCOUNT_ADDRESS=
WALLET_ADDRESS=

# Optional: Priority fees (in SOL)
PRIORITY_FEE=0.00001

# Swap engine (used by 10-swap-collateral.ts / 11-swap-debt.ts). Mirrors the app: TITAN primary
# with a JUPITER fallback. Provide only the providers you have credentials for — with no Titan
# creds the engine uses Jupiter only.
TITAN_GATEWAY_URL=        # e.g. https://<host>/api/v1
TITAN_WS_URL=             # e.g. wss://<host>/api/v1/ws  (optional, Titan V3 quotes over WS)
TITAN_API_KEY=
JUPITER_API_KEY=          # omit to use the public, rate-limited Jupiter endpoint
# JUPITER_BASE_PATH=https://api.jup.ag/swap/v1
# SWAP_SLIPPAGE_MODE=DYNAMIC      # DYNAMIC | FIXED
# SWAP_SLIPPAGE_BPS=50
# SWAP_PLATFORM_FEE_BPS=0
# SWAP_DIRECT_ROUTES_ONLY=false

# Example Bank Addresses (Mainnet)
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOL_MINT=So11111111111111111111111111111111111111112
